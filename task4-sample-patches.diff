+CODEZIP="$(mktemp -d)/orchestrator.zip"
+# PATCHED (Option A): no `zip` binary — recursively zip the package dir via python
+# zipfile (arcnames relative to $PKG, matching `zip -r .`).
+python3 - "$CODEZIP" "$PKG" <<'PY'
+import sys, os, zipfile
+out, root = sys.argv[1], sys.argv[2]
+with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
+    for dirpath, _, files in os.walk(root):
+        for f in files:
+            full = os.path.join(dirpath, f)
+            z.write(full, arcname=os.path.relpath(full, root))
+PY
